FROM golang:1.26.2-alpine@sha256:f85330846cde1e57ca9ec309382da3b8e6ae3ab943d2739500e08c86393a21b1 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
RUN CGO_ENABLED=0 go build -tags postgres \
    -ldflags "-X main.Version=v4.19.1" \
    -o /out/migrate github.com/golang-migrate/migrate/v4/cmd/migrate

FROM alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40
RUN addgroup -S service && adduser -S -G service service
COPY --from=build /out/migrate /usr/local/bin/migrate
COPY migrations /migrations
USER service
ENTRYPOINT ["/usr/local/bin/migrate"]
